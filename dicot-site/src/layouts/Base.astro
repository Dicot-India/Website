---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Consent from "../components/Consent.astro";
import WebMcp from "../components/WebMcp.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}

const { title, description, image = "/images/og-default.png", noindex = false, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
// Every indexable page has a Markdown mirror written by scripts/generate-markdown.mjs.
const markdownHref = `${canonical}index.md`;

const organisation = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${site.url}/#organization`,
  name: site.name,
  alternateName: "Dicot",
  url: site.url,
  logo: `${site.url}/images/logo.svg`,
  image: ogImage,
  description: site.description,
  foundingDate: site.founded,
  email: site.emails.sales,
  telephone: site.phones[0].label,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  sameAs: site.socials.map((s) => s.url),
  knowsAbout: [
    "SCADA",
    "Industrial IoT",
    "Data acquisition",
    "Industry 4.0",
    "Remote monitoring",
    "OPC UA",
    "Modbus",
    "MQTT",
  ],
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${site.url}/#website`,
  url: site.url,
  name: "Dicot Innovations",
  publisher: { "@id": `${site.url}/#organization` },
  inLanguage: "en",
};

const graph = [organisation, website, ...schema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!noindex && (
      <>
        <link rel="alternate" type="text/markdown" href={markdownHref} />
        <link rel="describedby" href="/llms.txt" />
        <link rel="alternate" type="application/json" href="/.well-known/mcp/server-card.json" />
      </>
    )}
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#0a0a28" />
    <meta name="author" content={site.name} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dicot Innovations" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dicot Innovations — SCADA and IIoT software" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@dicot_tech" />

    <link rel="icon" href="/images/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/images/favicon.png" />
    <link rel="preload" href="/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Consent />
    <WebMcp />
  </body>
</html>
