---
interface Props {
  title?: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  title = "Put your plant on the screen.",
  text = "Tell us your tag count, deployment type and timeline. We will route you to the right product and the nearest authorised partner.",
  primaryLabel = "Book a demo",
  primaryHref = "/contact/",
  secondaryLabel = "Talk to a dealer",
  secondaryHref = "/contact/#channel-partners",
} = Astro.props;
---
<section class="cta-band">
  <div class="wrap">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--primary" href={primaryHref}>{primaryLabel}</a>
      <a class="btn btn--ghost" href={secondaryHref}>{secondaryLabel}</a>
    </div>
  </div>
</section>
