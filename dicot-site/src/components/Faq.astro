---
import type { Faq } from "../data/products";

interface Props {
  items: Faq[];
  title?: string;
  intro?: string;
  id?: string;
}
const { items, title = "Questions buyers ask", intro, id = "faq" } = Astro.props;
---
<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap split">
    <div>
      <span class="eyebrow">FAQ</span>
      <h2 id={`${id}-title`}>{title}</h2>
      {intro && <p class="lede">{intro}</p>}
    </div>
    <div class="faq">
      {items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
