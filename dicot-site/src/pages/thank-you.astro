---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";

const title = "Request received | Dicot Innovations";
const description = "Thank you. Your request has reached the Dicot team.";
---
<Base title={title} description={description} noindex={true}>
  <section class="e404">
    <div class="wrap">
      <div data-thanks-default>
        <span class="mono">Message received</span>
        <h1>Thank you.</h1>
        <p>
          Your enquiry is with our team. We usually reply within one working day. If it is urgent, call
          <a href="tel:+919016683114">+91 90166 83114</a>.
        </p>
        <div class="btn-row" style="justify-content:center">
          <a class="btn btn--primary" href="/products/">Browse products</a>
          <a class="btn btn--ghost" href="/downloads/">Downloads</a>
        </div>
        <p class="small muted mt-3">We have not added you to any marketing list unless you opted in. See our <a href="/legal/privacy/">privacy policy</a>.</p>
      </div>

      <div data-thanks-vision-s hidden>
        <span class="mono">Vision S download</span>
        <h1>Check your inbox.</h1>
        <p>
          Your download link is on its way from <a href={`mailto:${site.emails.sales}`}>{site.emails.sales}</a>. It is
          valid for 48 hours. If it does not arrive within a few minutes, check spam, then write to us and we will resend
          it.
        </p>
        <div class="btn-row" style="justify-content:center">
          <a class="btn btn--primary" href="/downloads/vision-s/">Request another link</a>
          <a class="btn btn--ghost" href="/downloads/">All downloads</a>
        </div>
        <p class="small muted mt-3">
          We recorded your request and the consent you gave. You can withdraw it at any time by writing to
          <a href={`mailto:${site.emails.privacy}`}>{site.emails.privacy}</a> — withdrawing is as easy as giving consent.
          We keep the record for 24 months from our last contact. See the
          <a href="/legal/privacy/">privacy policy</a>.
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  const params = new URLSearchParams(location.search);
  if (params.get("type") === "vision-s") {
    document.querySelector<HTMLElement>("[data-thanks-default]")?.setAttribute("hidden", "");
    document.querySelector<HTMLElement>("[data-thanks-vision-s]")?.removeAttribute("hidden");
    document.title = "Vision S download link sent | Dicot Innovations";
  }
</script>

