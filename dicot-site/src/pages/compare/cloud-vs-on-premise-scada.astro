---
import Base from "../../layouts/Base.astro";
import Faq from "../../components/Faq.astro";
import Cta from "../../components/Cta.astro";
import { site } from "../../data/site";

const title = "Cloud SCADA vs On-Premise SCADA | Dicot";
const description =
  "Cloud SCADA or on-premise? Compare latency, offline operation, cost, security, remote access and scale — and see when a hybrid architecture is the right answer.";

const faqs = [
  {
    q: "Is cloud SCADA secure enough for a factory?",
    a: "Security depends on the design, not the location. A hosted platform needs encryption in transit and at rest, strong authentication, role-based access and a clear data-ownership agreement. An on-premise system needs patching, network segmentation and backups. Both can be secure or badly run; ask for specifics.",
  },
  {
    q: "What happens to data when the internet goes down?",
    a: "In a hybrid setup, the local logger keeps collecting and buffering. When the link returns, it forwards the backlog. Control continues locally; only the remote view is interrupted.",
  },
  {
    q: "Is cloud SCADA cheaper?",
    a: "It moves cost from capital to operating expense and removes server maintenance, but a long subscription can cost more than a perpetual licence over ten years. Compare total cost over the plant's life, including IT staff time.",
  },
  {
    q: "Can I move from on-premise to cloud later?",
    a: "Usually yes, if the on-premise product can forward data to the cloud. Vision C forwards to Vision Web with a one-click connection, so a plant can start local and add cloud visibility without replacing its logger.",
  },
  {
    q: "Which does Dicot recommend?",
    a: "Keep control on-premise and put monitoring in the cloud unless you have a specific reason to do otherwise. That is why Vision C forwards to Vision Web, and why Vision S can expose data through APIs and web clients.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const article = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Cloud SCADA vs on-premise SCADA",
  description: "A practical comparison for plant teams choosing a SCADA deployment model.",
  datePublished: "2026-11-18",
  dateModified: "2026-11-18",
  author: { "@id": `${site.url}/#organization` },
  publisher: { "@id": `${site.url}/#organization` },
  mainEntityOfPage: `${site.url}/compare/cloud-vs-on-premise-scada/`,
};
---
<Base title={title} description={description} schema={[article, faqSchema]}>
  <div class="wrap"><nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li>Compare</li><li>Cloud vs on-premise</li></ol></nav></div>

  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Comparison · updated November 2026</span>
      <h1>Cloud SCADA vs on-premise SCADA.</h1>
      <p class="lede">
        Cloud SCADA runs on a vendor-hosted platform and is reached through a browser or mobile app. On-premise SCADA
        runs on servers inside the plant. The right choice is usually both: control stays local, monitoring goes to the
        cloud.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Factor</th><th>Cloud SCADA</th><th>On-premise SCADA</th></tr></thead>
          <tbody>
            <tr><td><strong>Update latency</strong></td><td>50–100 ms typical, dependent on link</td><td>Milliseconds, local network</td></tr>
            <tr><td><strong>Offline operation</strong></td><td>Needs local buffering for gaps</td><td>Full operation without internet</td></tr>
            <tr><td><strong>Remote access</strong></td><td>Native, any browser or phone</td><td>VPN, remote desktop or web client</td></tr>
            <tr><td><strong>Upfront cost</strong></td><td>Low — subscription</td><td>Higher — server, licences, setup</td></tr>
            <tr><td><strong>Long-term cost</strong></td><td>Recurring subscription</td><td>Support and renewals, no hosting</td></tr>
            <tr><td><strong>IT workload</strong></td><td>Vendor handles patching and uptime</td><td>Your team handles servers and backups</td></tr>
            <tr><td><strong>Data location</strong></td><td>Vendor infrastructure</td><td>Inside the plant</td></tr>
            <tr><td><strong>Scale</strong></td><td>Add tags and sites without hardware</td><td>Add servers and licences</td></tr>
            <tr><td><strong>Best fit</strong></td><td>Remote sites, multi-site, small teams</td><td>Regulated, high-speed or air-gapped plants</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap split">
      <div>
        <span class="eyebrow">The usual answer</span>
        <h2>Hybrid, with control at the edge.</h2>
        <p class="lede">
          The plant keeps a local logger that runs the line and stores history. The cloud receives a copy for remote
          monitoring, alarms and management reporting. If the network drops, production does not.
        </p>
      </div>
      <div class="spec-box">
        <table class="spec-table">
          <tr><th>Edge</th><td>Vision C — local logging, alarms and forwarding</td></tr>
          <tr><th>Cloud</th><td>Vision Web — browser, mobile, WhatsApp/Telegram alarms</td></tr>
          <tr><th>Enterprise</th><td>Vision S — 60,000 tags, audit trails, PostgreSQL</td></tr>
          <tr><th>Reports</th><td>VGraphic — branded PDF output from plant files</td></tr>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2">
      <div class="card">
        <h3>Choose cloud when…</h3>
        <ul role="list" class="mb-0">
          <li>Your sites are remote or unmanned.</li>
          <li>Operators and managers need phone access.</li>
          <li>You do not want to run servers or a VPN.</li>
          <li>You need to add sites without buying hardware.</li>
          <li>Alarms must reach people on WhatsApp, SMS or Telegram.</li>
        </ul>
      </div>
      <div class="card">
        <h3>Choose on-premise when…</h3>
        <ul role="list" class="mb-0">
          <li>The process cannot stop when the internet does.</li>
          <li>Audit trails and data residency must stay in the plant.</li>
          <li>Scan rates are high and latency matters.</li>
          <li>The site is air-gapped by policy.</li>
          <li>You already run industrial servers and OT security.</li>
        </ul>
      </div>
    </div>
  </section>

  <Faq items={faqs} title="Deployment questions" />

  <Cta title="Design the architecture with us." text="Tell us the sites, the tags and what happens when the link drops. We will draw the simplest architecture that survives it." primaryLabel="Book a demo" secondaryLabel="Compare products" secondaryHref="/products/" />
</Base>
