---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import { site } from "../data/site";

const title = "SCADA & IIoT Solutions for Manufacturers | Dicot";
const description =
  "OEM white-labelling, integration and panel building, Industry 4.0 consulting and custom SCADA development from Dicot. Start with a pilot on one machine, then scale across the plant.";

const solutions = [
  {
    title: "OEM & white-labelling",
    text: "Ship Vision C or Vision Web under your own brand. Your customers see your product; we handle the software, updates and licensing behind it.",
    points: ["Your logo, your installer, your support tier", "Licensing matched to machine warranty", "No software team needed in-house"],
  },
  {
    title: "IIoT & Industry 4.0 consulting",
    text: "Work out what to connect, what to store and what the plant floor actually needs to see. We start with your equipment list and network, not a slide deck.",
    points: ["Tag and protocol audit", "Cloud, on-premise or hybrid architecture", "Alarm and reporting design"],
  },
  {
    title: "Custom SCADA development",
    text: "When configuration stops being enough, our team builds screens, reports and integrations on top of Vision S and Vision C.",
    points: ["Custom screens and reports", "Third-party database and API integration", "C scripting inside Vision S"],
  },
  {
    title: "Data acquisition at the edge",
    text: "Vision C collects from PLCs, meters and legacy devices over Modbus and serial, then forwards clean data to Vision Web or your own systems.",
    points: ["Modbus TCP/IP, RTU, BCD and AIBUS", "Local history that survives network outages", "One-click cloud forwarding"],
  },
];

const steps = [
  { n: "01", title: "Map the plant", text: "List the machines, protocols, tag counts and who needs to see what. We do this with your team, on a call or on site." },
  { n: "02", title: "Pilot one asset", text: "Connect one machine or line, prove the data and the alarms, and measure whether the report saves anyone time." },
  { n: "03", title: "Scale with a partner", text: "Roll out through an authorised dealer or with our team, with licensing that matches how the plant buys." },
];
---
<Base title={title} description={description}>
  <div class="wrap"><nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li>Solutions</li></ol></nav></div>

  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Solutions</span>
      <h1>Connect the factory without rebuilding it.</h1>
      <p class="lede">
        Dicot works with machine builders, integrators and plant teams. The software is the product, but the engagement
        is practical: connect what exists, prove the value on one asset, then scale.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/contact/">Talk to an engineer</a>
        <a class="btn btn--ghost" href="/products/">See the products</a>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="new-capability">
        <div>
          <span class="eyebrow">New capability</span>
          <h2>Integration and panel building.</h2>
          <p>
            Dicot is adding system integration and control-panel building to what we deliver. A plant can now source the
            panel, the SCADA software and the commissioning from one team.
          </p>
          <a class="btn btn--primary mt-2" href="/contact/?interest=integration">Talk about a panel project</a>
        </div>
        <ul role="list">
          <li><strong>Panel design and build.</strong> Control panels specified around the machines they run.</li>
          <li><strong>PLC, HMI and SCADA integration.</strong> One data model from the machine to the report.</li>
          <li><strong>Retrofits.</strong> Legacy equipment brought into the same monitoring stack.</li>
          <li><strong>One accountable team.</strong> From the panel drawing to the first report.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2">
      {solutions.map((s) => (
        <article class="card">
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <ul class="mt-2" role="list">
            {s.points.map((p) => <li class="small">{p}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <div class="section-head">
        <div><span class="eyebrow">How it works</span><h2>Three steps, no big-bang rollout.</h2></div>
        <p>Most failed SCADA projects start with a plant-wide scope. We start with one asset and earn the next one.</p>
      </div>
      <div class="feature-grid">
        {steps.map((s) => (
          <div class="feature">
            <span class="feature__num">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split split--center">
      <div>
        <span class="eyebrow">For partners</span>
        <h2>Build a practice on our software.</h2>
        <p class="lede">
          Dealers and system integrators get dealer pricing, technical training and a platform that is configured
          rather than coded from scratch.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href={site.partnerForm} rel="noopener">Apply as a partner</a>
          <a class="btn btn--ghost" href="/partners/">Partner programme</a>
        </div>
      </div>
      <div class="spec-box">
        <table class="spec-table">
          <tr><th>Machine builders</th><td>White-label Vision C or Vision Web</td></tr>
          <tr><th>Integrators</th><td>Configure, don't code, each project</td></tr>
          <tr><th>Dealers</th><td>Sell and support in your territory</td></tr>
          <tr><th>Plant teams</th><td>Buy through a partner or direct</td></tr>
        </table>
      </div>
    </div>
  </section>

  <Cta title="Start with one machine." text="Send us the equipment list and the outcome you need. We will tell you what is possible, and what is not." />
</Base>
