---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";

const title = "Careers at Dicot | Industrial Software, Ahmedabad";
const description =
  "Work on SCADA and IIoT software used in 1,000+ plants. See open roles at Dicot Innovations in Ahmedabad, or send your CV to careers@dicot.tech.";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

type Role = {
  title: string;
  department: string;
  location: string;
  type?: string;
  experience: string;
  description: string;
  salary?: string;
  posted: string;
};

const modules = import.meta.glob<Role>("../content/careers/*.json", { eager: true, import: "default" });
const roles = Object.values(modules).sort((a, b) => (b.posted || "").localeCompare(a.posted || ""));
---
<Base title={title} description={description}>
  <div class="wrap"><nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li>Careers</li></ol></nav></div>

  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Careers</span>
      <h1>Build software that runs the plant floor.</h1>
      <p class="lede">
        Dicot is a six-person core team in Ahmedabad building SCADA and IIoT products used in more than 1,000
        deployments. Small team, short decisions, real customers.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-3">
      <div class="card"><h3>Own a product, not a ticket</h3><p>Engineers here talk to the plant, not just to a backlog. What you build is commissioned by someone you can call.</p></div>
      <div class="card"><h3>Industrial scale, startup speed</h3><p>Your work reaches hundreds of manufacturers without passing through five approval layers.</p></div>
      <div class="card"><h3>Ahmedabad, on-site</h3><p>We work from the Makarba office. Roles are listed with their location when they open.</p></div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <div class="section-head">
        <div><span class="eyebrow">Open roles</span><h2>Current openings.</h2></div>
        <p>Roles are added here as they open. If nothing fits today, send your CV anyway.</p>
      </div>

      {roles.length === 0 ? (
        <div class="empty">
          <p><strong>No open roles right now.</strong></p>
          <p>We still read every application. Send your CV and a short note about what you want to work on to
            <a href={`mailto:${site.emails.careers}`}>{site.emails.careers}</a>.</p>
          <a class="btn btn--primary" href={`mailto:${site.emails.careers}?subject=Application%20%E2%80%94%20Dicot`}>Email your CV</a>
        </div>
      ) : (
        <div>
          {roles.map((role) => (
            <details class="role">
              <summary>
                <span>
                  <span class="role__title">{role.title}</span>
                  <span class="mono">{role.department} · {role.location} · {role.type ?? "Full-time"} · {role.experience}</span>
                </span>
                <span class="btn btn--ghost btn--small">Details &amp; apply</span>
              </summary>
              <div class="role__body">
                <p>{role.description}</p>
                {role.salary && <p class="role__salary"><strong>Salary / stipend:</strong> {role.salary}</p>}
                <a class="btn btn--primary btn--small" href="#apply" data-role={role.title}>Apply for this role</a>
              </div>
            </details>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section" id="apply">
    <div class="wrap narrow">
      <span class="eyebrow">Apply</span>
      <h2>Apply here.</h2>
      <p class="lede">One form, one resume upload, no account. Every application is read by a person.</p>

      <div class="form-error mt-2" id="form-error" hidden>
        Your application did not go through. Try again, or email it to <a href={`mailto:${site.emails.careers}`}>{site.emails.careers}</a>.
      </div>
      {!turnstileSiteKey && (
        <div class="form-error mt-2">
          Online applications are temporarily unavailable. Please email your CV to <a href={`mailto:${site.emails.careers}`}>{site.emails.careers}</a>.
        </div>
      )}

      <form class="form mt-2" action="/careers-apply.php" method="post" accept-charset="utf-8" enctype="multipart/form-data">
        <div class="field">
          <label for="role">Role <span class="req">*</span></label>
          <select id="role" name="role" required>
            {roles.map((role) => <option value={role.title}>{role.title}</option>)}
            <option value="Open application">Other / open application</option>
          </select>
        </div>
        <div class="grid-2">
          <div class="field">
            <label for="name">Name <span class="req">*</span></label>
            <input id="name" name="name" type="text" autocomplete="name" required maxlength="100" />
          </div>
          <div class="field">
            <label for="phone">Contact number <span class="req">*</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" required maxlength="40" />
          </div>
          <div class="field">
            <label for="email">Email <span class="req">*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" required maxlength="160" />
          </div>
          <div class="field">
            <label for="resume">Resume <span class="req">*</span></label>
            <input id="resume" name="resume" type="file" accept=".pdf,.doc,.docx" required />
            <p class="form-note mb-0">PDF, DOC or DOCX, up to 5 MB.</p>
          </div>
        </div>
        <div class="field">
          <label for="fit">What makes you uniquely positioned to succeed in this role? <span class="req">*</span></label>
          <textarea id="fit" name="fit" required maxlength="3000"></textarea>
        </div>
        <div class="field">
          <label for="obsession">
            What is an obsession, rabbit hole, or random skill you’ve spent hours mastering on your own, outside of
            college classes, and what does that say about how you work? <span class="req">*</span>
          </label>
          <textarea id="obsession" name="obsession" required maxlength="3000"></textarea>
        </div>
        <div class="hp" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <label class="check">
          <input type="checkbox" name="consent" value="yes" required />
          <span>I agree that Dicot may use these details and my resume to assess this application, as described in the <a href="/legal/privacy/">privacy policy</a>. <span class="req">*</span></span>
        </label>
        {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
        <div>
          <button class="btn btn--primary" type="submit" disabled={!turnstileSiteKey}>Submit application</button>
        </div>
        <p class="form-note">
          We keep applications for 12 months unless you ask us to delete them. Required fields are marked with
          <span class="req">*</span>. Prefer email? Send your CV to <a href={`mailto:${site.emails.careers}`}>{site.emails.careers}</a>.
        </p>
      </form>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow center">
      <h2>How we hire.</h2>
      <p class="lede">
        A conversation about your work, a practical discussion around a real problem, and a meeting with the team you
        would join.
      </p>
      <p class="small muted">Send applications to <a href={`mailto:${site.emails.careers}`}>{site.emails.careers}</a>. We keep CVs for 12 months unless you ask us to delete them.</p>
    </div>
  </section>

  {turnstileSiteKey && <script async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>}
</Base>

<script>
  const params = new URLSearchParams(location.search);
  if (params.get("error") === "1") {
    document.getElementById("form-error")?.removeAttribute("hidden");
    document.getElementById("apply")?.scrollIntoView();
  }

  // A "Apply for this role" link preselects the role in the shared form.
  const roleSelect = document.getElementById("role") as HTMLSelectElement | null;
  document.querySelectorAll<HTMLElement>("[data-role]").forEach((link) => {
    link.addEventListener("click", () => {
      if (roleSelect) roleSelect.value = link.dataset.role ?? roleSelect.value;
    });
  });
</script>
