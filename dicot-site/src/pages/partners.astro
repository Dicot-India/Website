---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import { site } from "../data/site";
import { partnerTypes } from "../data/content";

const title = "SCADA Dealer & OEM Partner Programme | Dicot";
const description =
  "Become a Dicot dealer, system integrator or OEM partner. Sell and support Vision C, Vision S and Vision Web with dealer pricing, training and white-label options.";
---
<Base title={title} description={description}>
  <div class="wrap"><nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li>Partners</li></ol></nav></div>

  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Partner programme</span>
      <h1>Sell, integrate or ship it under your brand.</h1>
      <p class="lede">
        Dicot works through dealers, system integrators and machine builders. If you already sell automation, panels
        or machines, our software adds a recurring layer without adding a development team.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href={site.partnerForm} rel="noopener">Apply to become a partner</a>
        <a class="btn btn--ghost" href={`mailto:${site.emails.sales}?subject=Partner%20enquiry`}>Email the team</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-3">
      {partnerTypes.map((t, i) => (
        <article class="card">
          <span class="feature__num">0{i + 1}</span>
          <h3>{t.title}</h3>
          <p>{t.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap split split--center">
      <div>
        <span class="eyebrow">What you get</span>
        <h2>A product you can support, not a project you have to code.</h2>
        <p class="lede">
          Our partners do not start from a blank screen. They configure Vision C or Vision Web, reuse screens and
          reports, and hand over a system the customer can actually operate.
        </p>
        <ul class="mt-3" role="list">
          <li><strong>Dealer pricing</strong> on the full product suite.</li>
          <li><strong>Technical training</strong> on configuration, protocols and commissioning.</li>
          <li><strong>White-label options</strong> for OEMs, including installer and branding.</li>
          <li><strong>Escalation support</strong> from the engineers who build the software.</li>
          <li><strong>Lead routing</strong> for enquiries in your territory.</li>
        </ul>
      </div>
      <div class="spec-box">
        <table class="spec-table">
          <tr><th>Territories</th><td>India and international</td></tr>
          <tr><th>Products</th><td>Vision C, Vision S, Vision Web, VGraphic</td></tr>
          <tr><th>Partner types</th><td>Dealer, integrator, OEM</td></tr>
          <tr><th>Application</th><td>Online form, reviewed by our team</td></tr>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split split--center">
      <div>
        <span class="eyebrow">How to apply</span>
        <h2>Tell us what you already do.</h2>
        <p class="lede">
          The application asks for your company, territory, industries and the products you currently sell. We review
          fit and come back with next steps. There is no fee to apply.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href={site.partnerForm} rel="noopener">Open the application form</a>
        </div>
        <p class="form-note mt-2">The form is hosted by Google Forms. Read how we handle form data in our <a href="/legal/privacy/">privacy policy</a>.</p>
      </div>
      <div class="card">
        <h3>Prefer to talk first?</h3>
        <p>Write to <a href={`mailto:${site.emails.sales}`}>{site.emails.sales}</a> or call {site.phones[0].label}. Tell us your territory and the industries you serve.</p>
        <p class="mb-0"><a href="/contact/">Contact page →</a></p>
      </div>
    </div>
  </section>

  <Cta title="Grow with a platform, not a one-off project." text="Apply once and we will map the right partnership model to your business." primaryLabel="Apply now" primaryHref={site.partnerForm} secondaryLabel="See products" secondaryHref="/products/" />
</Base>
