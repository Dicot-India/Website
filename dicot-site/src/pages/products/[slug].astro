---
import Base from "../../layouts/Base.astro";
import Faq from "../../components/Faq.astro";
import Cta from "../../components/Cta.astro";
import ProductVisual from "../../components/ProductVisual.astro";
import { products } from "../../data/products";
import { site } from "../../data/site";

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product: p } = Astro.props;

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.url },
    { "@type": "ListItem", position: 2, name: "Products", item: `${site.url}/products/` },
    { "@type": "ListItem", position: 3, name: p.name, item: `${site.url}/products/${p.slug}/` },
  ],
};

const app =
  p.status === "upcoming"
    ? {
        "@context": "https://schema.org",
        "@type": "Product",
        name: p.name,
        description: p.summary,
        url: `${site.url}/products/${p.slug}/`,
        image: `${site.url}${p.image}`,
        category: p.category,
        brand: { "@type": "Brand", name: "Dicot" },
        isRelatedTo: {
          "@type": "SoftwareApplication",
          name: "Vision S",
          url: `${site.url}/products/vision-s/`,
        },
        additionalProperty: {
          "@type": "PropertyValue",
          name: "Availability",
          value: "In development",
        },
      }
    : {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: p.name,
        applicationCategory: "BusinessApplication",
        applicationSubCategory: p.category,
        operatingSystem:
          p.slug === "vision-web" ? "Web browser, Windows, Android" : p.slug === "vgraphic" ? "Web browser, Windows, Android" : "Windows",
        description: p.summary,
        url: `${site.url}/products/${p.slug}/`,
        image: `${site.url}${p.image}`,
        publisher: { "@id": `${site.url}/#organization` },
        featureList: p.features.map((f) => f.title),
        softwareHelp: { "@type": "CreativeWork", url: `${site.url}/downloads/` },
      };

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: p.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const related = products.filter((x) => x.slug !== p.slug).slice(0, 3);
const updated = "November 2026";
const og: Record<string, string> = {
  "vision-c": "/images/og-vision-c.png",
  "vision-web": "/images/og-vision-web.png",
  "vision-s": "/images/og-vision-s.png",
  "vision-s-lite": "/images/og-vision-s-lite.png",
  vgraphic: "/images/og-vgraphic.png",
};
---
<Base title={p.metaTitle} description={p.metaDescription} image={og[p.slug]} schema={[breadcrumb, app, faqSchema]}>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol><li><a href="/">Home</a></li><li><a href="/products/">Products</a></li><li>{p.name}</li></ol>
    </nav>
  </div>

  <section class="page-hero">
    <div class="wrap product-hero">
      <div>
        <span class="eyebrow">{p.category}</span>
        <h1>{p.name}</h1>
        <p class="lede">{p.tagline}</p>
        <p class="lede">{p.summary}</p>
        <div class="btn-row">
          {p.status === "upcoming" ? (
            <>
              <a class="btn btn--primary" href={`/contact/?interest=${p.slug}`}>Register interest</a>
              <a class="btn btn--ghost" href="/contact/#channel-partners">Talk to a dealer</a>
            </>
          ) : (
            <>
              <a class="btn btn--primary" href="/contact/">Book a demo</a>
              <a class="btn btn--ghost" href="/pricing/">See plans</a>
            </>
          )}
        </div>
        <p class="updated">
          {p.status === "upcoming" ? "In development · editions and pricing at launch" : `Last updated ${updated}`}
        </p>
      </div>
      <ProductVisual product={p} lazy={false} />
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Key facts</span>
        <h2>What {p.name} does.</h2>
        <div class="card mt-3">
          <h3>Best for</h3>
          <p>{p.bestFor}</p>
        </div>
      </div>
      <div class="spec-box">
        <table class="spec-table">
          <tbody>
            {p.facts.map((f) => (
              <tr><th>{f.label}</th><td>{f.value}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Capabilities</span>
          <h2>What you get on day one.</h2>
        </div>
        <p>No add-on modules to buy before the product is useful. These are part of the platform.</p>
      </div>
      <div class="feature-grid">
        {p.features.map((f, i) => (
          <div class="feature">
            <span class="feature__num">0{i + 1}</span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {p.plans.length > 0 && (
    <section class="section" id="plans">
      <div class="wrap split">
        <div>
          <span class="eyebrow">Plans &amp; licensing</span>
          <h2>Licence it the way your plant buys.</h2>
          <p class="lede">{p.planNote}</p>
          <div class="btn-row">
            <a class="btn btn--primary" href="/contact/">Request a quote</a>
            <a class="btn btn--ghost" href="/contact/#channel-partners">Find a dealer</a>
          </div>
        </div>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Edition</th><th>What it includes</th></tr></thead>
            <tbody>
              {p.plans.map((plan) => (
                <tr><td><strong>{plan.name}</strong></td><td>{plan.detail}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  {p.status === "upcoming" && (
    <section class="section" id="plans">
      <div class="wrap split split--center">
        <div>
          <span class="eyebrow">Launch status</span>
          <h2>In development. Register your interest.</h2>
          <p class="lede">{p.planNote}</p>
          <div class="btn-row">
            <a class="btn btn--primary" href={`/contact/?interest=${p.slug}`}>Register interest</a>
            <a class="btn btn--ghost" href="/contact/#channel-partners">Talk to a dealer</a>
          </div>
        </div>
        <div class="card">
          <span class="mono muted">What we can confirm today</span>
          <ul role="list" class="mb-0">
            <li>It is a lighter edition of Vision S.</li>
            <li>It uses a reduced protocol set.</li>
            <li>It carries a smaller design library.</li>
            <li>It targets cost-sensitive applications.</li>
          </ul>
        </div>
      </div>
    </section>
  )}

  {p.requirements.length > 0 && (
    <section class="section section--paper">
      <div class="wrap split">
        <div>
          <span class="eyebrow">Requirements</span>
          <h2>What it runs on.</h2>
          <p class="lede">Modest hardware by industrial software standards. Check these before a pilot.</p>
        </div>
        <ul class="card" role="list">
          {p.requirements.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </section>
  )}

  <Faq items={p.faqs} title={`${p.name}: questions buyers ask`} />

  <section class="section section--white">
    <div class="wrap">
      <div class="section-head">
        <div><span class="eyebrow">Related</span><h2>Works with the rest of the suite.</h2></div>
        <a class="btn btn--ghost btn--small" href="/products/">All products</a>
      </div>
      <div class="grid-3">
        {related.map((r) => (
          <a class="product-card" href={`/products/${r.slug}/`}>
            <div class="product-card__top"><h3>{r.name}</h3><span class="product-card__cat">{r.category}</span></div>
            <p>{r.tagline}</p>
            <div class="product-card__facts">{r.facts.slice(0, 2).map((f) => <span class="chip">{f.value}</span>)}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Cta
    title={p.status === "upcoming" ? "Be first to see Vision S Lite." : `See ${p.name} on your data.`}
    text={p.status === "upcoming"
      ? "Tell us the application and tag scope. We will share availability, editions and pricing when they are confirmed."
      : "A 30-minute demo with your tags, your protocols and your questions. No slide deck."}
    primaryLabel={p.status === "upcoming" ? "Register interest" : "Book a demo"}
    primaryHref={p.status === "upcoming" ? `/contact/?interest=${p.slug}` : "/contact/"}
  />
</Base>
