---
import Base from "../../layouts/Base.astro";
import { site } from "../../data/site";
import { downloadPolicy, visionSBuilds } from "../../data/downloads";

const title = "Download Vision S | Green key and grey key installers";
const description =
  "Download the Vision S installer that matches your key: the green-key build or the Vision S Version 2026 grey-key build. Request a temporary email link or start the download.";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const software = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Vision S",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Windows 7, Windows 10",
  softwareVersion: "2026",
  url: `${site.url}${downloadPolicy.pagePath}`,
  publisher: { "@id": `${site.url}/#organization` },
  description:
    "Enterprise SCADA for Windows. Two installers are published: the green-key build and the Vision S Version 2026 grey-key build.",
};

const [greenKey, greyKey] = visionSBuilds;
---

<Base title={title} description={description} schema={[software]}>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol><li><a href="/">Home</a></li><li><a href="/downloads/">Downloads</a></li><li>Vision S</li></ol>
    </nav>
  </div>

  <section class="vs-hero">
    <div class="wrap vs-hero__grid">
      <div class="vs-hero__copy">
        <div class="vs-index"><span>Vision S</span><span>Installers</span><span>Windows</span></div>
        <h1>Download the build that matches your key.</h1>
        <p class="lede">
          Two installers are published. Choose the one that matches the licence key you were issued — the green-key
          build, or the Vision S Version 2026 grey-key build. Tell us who you are and we either email a temporary link
          valid for {downloadPolicy.linkHours} hours or start the download now.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="#request">Choose your build</a>
          <a class="btn btn--ghost" href="#keys">Which key do I have?</a>
        </div>
        <div class="hero-meta">
          <span>{greenKey.size} · green key</span>
          <span>{greyKey.size} · grey key</span>
          <span>ISO · Windows 7 and 10</span>
          <span>{downloadPolicy.linkHours}-hour link</span>
        </div>
      </div>

      <div class="vs-builds">
        {visionSBuilds.map((build) => (
          <a class={`vs-build vs-build--${build.id}`} href="#request">
            <span class="vs-build__band" aria-hidden="true" />
            <span class="vs-build__head">
              <span class="vs-build__key">{build.key}</span>
              {build.id === "grey" && <span class="vs-build__badge">Version 2026</span>}
            </span>
            <strong class="vs-build__name">{build.name}</strong>
            <span class="vs-build__file">{build.file}</span>
            <span class="vs-build__facts">
              <span>{build.size}</span>
              <span>File dated {build.updated}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--white vs-keys" id="keys">
    <div class="wrap vs-keys__grid">
      <div>
        <span class="eyebrow">Which key do I have?</span>
        <h2>The key label states its colour.</h2>
        <p class="lede">
          Choose the build with the same colour as your key; the other build will not accept it. If you are unsure, send
          a photo of the key label to <a href={`mailto:${site.emails.sales}`}>{site.emails.sales}</a> before downloading
          a large file.
        </p>
        <p class="form-note mb-0">
          The installers do not include a licence. Vision S still needs a valid key, issued by your dealer or by our
          sales team.
        </p>
      </div>
      <div class="spec-box vs-keys__table">
        <div class="table-wrap vs-keys__scroll">
          <table class="spec-table">
            <thead>
              <tr><th scope="col">Installer</th><th scope="col">Green key</th><th scope="col">Grey key</th></tr>
            </thead>
            <tbody>
              <tr><th scope="row">Release</th><td>Vision S</td><td>Vision S Version 2026</td></tr>
              <tr><th scope="row">File</th><td class="mono-cell">{greenKey.file}</td><td class="mono-cell">{greyKey.file}</td></tr>
              <tr><th scope="row">Size</th><td>{greenKey.size}</td><td>{greyKey.size}</td></tr>
              <tr><th scope="row">File dated</th><td>{greenKey.updated}</td><td>{greyKey.updated}</td></tr>
              <tr><th scope="row">Use it if</th><td>your key label is green</td><td>your key label is grey</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="section vs-request" id="request">
    <div class="wrap vs-request__grid">
      <div class="vs-panel">
        <span class="eyebrow">Request the installer</span>
        <h2 class="vs-h2">Four steps, then the file.</h2>
        <p class="vs-sub">
          Both builds are large. We record who asked for which build, so we can help if the install needs it.
        </p>

        <div class="form-error" id="download-error" hidden>
          <strong>We could not start the download.</strong>
          <span id="download-error-detail">Please try again, or email <a href={`mailto:${site.emails.sales}`}>{site.emails.sales}</a> with the build you need.</span>
        </div>

        <div class="form-success" id="download-success" hidden>
          <strong>Check your inbox.</strong>
          <p class="mb-0">
            Your download link is on its way from {site.emails.sales}. It is valid for {downloadPolicy.linkHours} hours.
            Nothing arrived? Check spam, then email <a href={`mailto:${site.emails.sales}`}>{site.emails.sales}</a>.
          </p>
        </div>

        {!turnstileSiteKey && (
          <div class="form-error">
            The download form is temporarily unavailable. Please email
            <a href={`mailto:${site.emails.sales}`}>{site.emails.sales}</a> with the build you need and we will send the link.
          </div>
        )}

        <form
          class="form download-form"
          action={downloadPolicy.endpoint}
          method="post"
          accept-charset="utf-8"
          toolname="request_vision_s_download"
          tooldescription="Request a Vision S installer download link. Requires the person's own name, company, work email and consent; the form does not submit itself."
        >
          <fieldset class="field vs-block">
            <legend><span class="vs-step">01</span> Which build do you need? <span class="req">*</span></legend>
            <div class="build-grid">
              {visionSBuilds.map((build) => (
                <label class={`build-card build-card--${build.id}`}>
                  <input type="radio" name="build" value={build.id} checked={build.id === "green"} required />
                  <span class="build-card__body">
                    <span class="build-card__band" aria-hidden="true" />
                    <span class="build-card__key">{build.key}</span>
                    <span class="build-card__name">{build.name}</span>
                    <span class="build-card__meta">{build.size} · file dated {build.updated}</span>
                    <span class="build-card__note">{build.summary}</span>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="field vs-block">
            <legend><span class="vs-step">02</span> How should we deliver it? <span class="req">*</span></legend>
            <div class="choice-stack">
              <label class="choice">
                <input type="radio" name="mode" value="email" checked required />
                <span>
                  <strong>Email me a temporary link</strong>
                  <span class="choice__hint">Valid {downloadPolicy.linkHours} hours. Best on a slow or shared connection.</span>
                </span>
              </label>
              <label class="choice">
                <input type="radio" name="mode" value="direct" />
                <span>
                  <strong>Start the download now</strong>
                  <span class="choice__hint">Downloads in this browser straight away.</span>
                </span>
              </label>
            </div>
          </fieldset>

          <fieldset class="field vs-block">
            <legend><span class="vs-step">03</span> Who are you? <span class="req">*</span></legend>
            <div class="grid-2">
              <div class="field">
                <label for="name">Name <span class="req">*</span></label>
                <input id="name" name="name" type="text" autocomplete="name" required maxlength="100" />
              </div>
              <div class="field">
                <label for="company">Company <span class="req">*</span></label>
                <input id="company" name="company" type="text" autocomplete="organization" required maxlength="120" />
              </div>
              <div class="field">
                <label for="email">Work email <span class="req">*</span></label>
                <input id="email" name="email" type="email" autocomplete="email" required maxlength="160" />
              </div>
              <div class="field">
                <label for="phone">Phone (optional)</label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40" />
              </div>
            </div>
          </fieldset>

          <div class="honeypot" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>


          <fieldset class="vs-block vs-consent">
            <legend><span class="vs-step">04</span> Consent</legend>

            <div class="dl-notice" id="privacy-notice">
              <h3 class="dl-notice__title">Before you download</h3>
              <p class="mb-1">
                <strong>What we collect:</strong> your name, company, work email and, if you add it, your phone number; the
                build you chose, the time of the request, and a Cloudflare Turnstile security token. Your IP address is used
                only to stop repeated automated requests.
              </p>
              <p class="mb-1">
                <strong>Why:</strong> to send the download link or start the download, to help you if the install needs it,
                and to keep this form from being abused. We do not sell your data and we do not use it for unrelated
                advertising.
              </p>
              <p class="mb-1">
                <strong>How long:</strong> {downloadPolicy.retention}. Security logs are kept for up to 90 days.
              </p>
              <p class="mb-1">
                <strong>Your rights:</strong> you can ask for access, correction or erasure, and you can withdraw consent at
                any time. Withdrawing is as easy as giving it: use the link in your confirmation email or write to
                <a href={`mailto:${site.emails.privacy}`}>{site.emails.privacy}</a>. Grievance Officer:
                <a href={`mailto:${site.emails.privacy}`}>{site.emails.privacy}</a>. Full detail in the
                <a href={downloadPolicy.privacyPath}>privacy policy</a> (version 2.2).
              </p>
              <p class="mb-0 form-note">
                This form is for business users aged 18 or over. Please do not send personal or sensitive data about anyone
                else.
              </p>
            </div>

            <label class="consent-field">
              <input type="checkbox" name="consent" value="yes" required />
              <span>
                I agree that Dicot Innovations may use these details to send my Vision S download link and to contact me
                about this download. I have read the <a href={downloadPolicy.privacyPath}>privacy policy</a>.
                <span class="req">*</span>
              </span>
            </label>

            <label class="consent-field consent-field--optional">
              <input type="checkbox" name="updates" value="yes" />
              <span>Send me occasional product updates. Optional, and I can unsubscribe at any time.</span>
            </label>
          </fieldset>

          {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>}

          <div class="btn-row">
            <button class="btn btn--primary" type="submit">Get the download</button>
            <a class="btn btn--ghost" href="/downloads/">Back to all downloads</a>
          </div>

          <p class="form-note mb-0" id="download-status" role="status" hidden>
            Your download is starting. A file this size takes a few seconds to appear — keep this tab open. If nothing
            happens, choose the email option above and we will send the link instead.
          </p>

          <p class="form-note mb-0">
            This form records the request and the consent you give. We keep that record for
            {downloadPolicy.retention}, then delete it.
          </p>
        </form>

        <noscript>
          <p class="form-note">
            JavaScript is off, so the confirmation banner cannot appear here. After you submit, the link email or the
            download starts immediately. If nothing happens, email
            <a href={`mailto:${site.emails.sales}`}>{site.emails.sales}</a>.
          </p>
        </noscript>
      </div>


      <aside class="vs-aside">
        <div class="vs-note">
          <span class="vs-note__label">Before you install</span>
          <ol class="vs-steps">
            <li>Windows 7 or Windows 10, 4 GB RAM recommended (1 GB minimum).</li>
            <li>PostgreSQL is needed for historical logging.</li>
            <li>Mount the ISO, or write it to a DVD, then run the setup inside.</li>
            <li>Keep your licence key and licence ID to hand.</li>
          </ol>
        </div>

        <div class="vs-note">
          <span class="vs-note__label">Need help?</span>
          <p class="vs-note__text">Include the build, your licence ID and the Windows version so we can help faster.</p>
          <p class="vs-contact">
            <a href={`mailto:${site.emails.sales}`}>{site.emails.sales}</a>
            {site.phones.map((phone) => (
              <>
                <br /><a href={`tel:${phone.href}`}>{phone.label}</a>{phone.primary ? " (primary)" : ""}
              </>
            ))}
          </p>
          <a class="btn btn--ghost btn--small" href="/support/">Open a support ticket</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section vs-next">
    <div class="wrap">
      <div class="section-head section-head--sub">
        <div>
          <span class="eyebrow">After you submit</span>
          <h2>From request to installed.</h2>
        </div>
      </div>
      <ol class="vs-path">
        <li>
          <span class="vs-path__step">01</span>
          <h3>Request</h3>
          <p>Build, delivery and your details. The request and the consent you gave are recorded together.</p>
        </li>
        <li>
          <span class="vs-path__step">02</span>
          <h3>Link or download</h3>
          <p>
            A signed link is emailed to you and stays valid for {downloadPolicy.linkHours} hours, or the file starts in
            this browser.
          </p>
        </li>
        <li>
          <span class="vs-path__step">03</span>
          <h3>Install</h3>
          <p>Mount the ISO or write it to a DVD, run the setup, then enter the licence key from your dealer.</p>
        </li>
      </ol>
    </div>
  </section>

  {turnstileSiteKey && <script async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>}
</Base>

<script>
  const params = new URLSearchParams(location.search);
  const form = document.querySelector<HTMLFormElement>(".download-form");
  const errorPanel = document.getElementById("download-error");
  const successPanel = document.getElementById("download-success");
  const errorDetail = document.getElementById("download-error-detail");
  const statusNote = document.getElementById("download-status");
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const submitLabel = submitButton?.textContent ?? "";
  let restoreTimer = 0;

  const reasons: Record<string, string> = {
    rate: "Too many requests from this connection. Wait a few minutes, then try again, or email sales@dicot.tech.",
    fields: "Some details are missing or look wrong. Check the name, company and work email, and tick the consent box.",
    token: "The security check did not pass. Reload the page and try again.",
    mail: "The link email could not be sent. Try the direct download instead, or email sales@dicot.tech.",
    config: "The download form is not configured right now. Please email sales@dicot.tech.",
  };

  const restoreSubmit = () => {
    window.clearTimeout(restoreTimer);
    if (submitButton) {
      submitButton.textContent = submitLabel;
      submitButton.removeAttribute("aria-busy");
    }
  };

  if (params.get("error") === "1" && errorPanel) {
    const reason = params.get("reason") ?? "";
    if (errorDetail && reasons[reason]) errorDetail.textContent = reasons[reason];
    errorPanel.removeAttribute("hidden");
    errorPanel.scrollIntoView({ block: "center" });
    // Drop the reason so a reload cannot repeat a message about an old attempt.
    history.replaceState({}, "", location.pathname);
  }

  if (params.get("sent") === "1" && successPanel) {
    successPanel.removeAttribute("hidden");
    successPanel.scrollIntoView({ block: "center" });
    history.replaceState({}, "", location.pathname);
  }

  form?.addEventListener("submit", () => {
    // A direct download keeps this page open, so an earlier failure banner used
    // to stay on screen and look like an error from the new attempt.
    errorPanel?.setAttribute("hidden", "");
    successPanel?.setAttribute("hidden", "");
    statusNote?.removeAttribute("hidden");
    if (submitButton) {
      submitButton.setAttribute("aria-busy", "true");
      submitButton.textContent = "Preparing your download…";
    }
    restoreTimer = window.setTimeout(restoreSubmit, 30000);
  });

  window.addEventListener("pageshow", restoreSubmit);
</script>


<style>
  /* Hero: a release band, not a paragraph about installers. */
  .vs-hero {
    position: relative;
    overflow: hidden;
    background: var(--navy);
    color: #fff;
    padding: clamp(32px, 4vw, 52px) 0 clamp(48px, 6vw, 80px);
  }
  .vs-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(90deg, #000, transparent 85%);
    pointer-events: none;
  }
  .vs-hero .wrap {
    position: relative;
    z-index: 1;
  }
  .vs-hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .vs-index {
    display: flex;
    gap: 12px;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ff6b6b;
    margin-bottom: 26px;
  }
  .vs-index span + span {
    color: #8f8fb0;
  }
  .vs-index span + span::before {
    content: "/";
    margin-right: 12px;
    color: #4c4c7a;
  }
  .vs-hero h1 {
    max-width: 15ch;
    font-size: clamp(2.2rem, 3.8vw, 3.4rem);
    text-wrap: balance;
  }
  .vs-hero .lede {
    color: #bfbfd4;
    max-width: 52ch;
  }
  .vs-hero .hero-meta {
    border-top: 1px solid var(--line-dark);
    padding-top: 20px;
    margin-top: 34px;
  }
  /* Global .btn--ghost assumes a light background; the hero is navy. */
  .vs-hero .btn--ghost {
    border-color: rgba(255, 255, 255, 0.3);
    color: #fff;
  }
  .vs-hero .btn--ghost:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.07);
  }

  .vs-builds {
    display: grid;
    gap: 14px;
  }
  .vs-build {
    position: relative;
    display: grid;
    gap: 5px;
    padding: 20px 22px 20px 28px;
    background: #14143a;
    border: 1px solid #2b2b5c;
    border-radius: var(--radius);
    text-decoration: none;
    color: #e9e9f2;
    overflow: hidden;
    transition: border-color 0.18s, transform 0.18s;
  }
  .vs-build:hover {
    border-color: rgba(203, 0, 0, 0.6);
    transform: translateY(-2px);
  }
  .vs-build__band {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 6px;
    background: var(--green);
  }
  .vs-build--grey .vs-build__band {
    background: #9295a3;
  }
  .vs-build__head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .vs-build__key {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .vs-build--green .vs-build__key {
    color: #58d29b;
  }
  .vs-build--grey .vs-build__key {
    color: #b6b6c6;
  }
  .vs-build__badge {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--navy);
    background: #fff;
    border-radius: 999px;
    padding: 3px 9px;
  }
  .vs-build__name {
    font-family: var(--display);
    font-size: 1.1rem;
    line-height: 1.25;
    font-weight: 700;
    color: #fff;
  }
  .vs-build__file {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: #8f8fb0;
  }
  .vs-build__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 6px;
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #b9b9cd;
  }

  /* Key comparison */
  .vs-keys__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .vs-keys__table {
    padding: 0;
    overflow: hidden;
  }
  .vs-keys__scroll {
    border: 0;
    border-radius: 0;
    background: transparent;
  }
  .vs-keys__scroll .spec-table {
    min-width: 460px;
  }
  .vs-keys__table .spec-table th {
    width: auto;
  }
  .vs-keys__table .spec-table th[scope="col"] {
    background: var(--paper-2);
    color: var(--ink);
    border-bottom-color: var(--line);
  }
  .mono-cell {
    font-family: var(--mono);
    font-size: 0.76rem;
  }

  /* Request */
  .vs-request__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.85fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }
  .vs-panel {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(22px, 3vw, 36px);
  }
  .vs-h2 {
    font-size: clamp(1.6rem, 2.6vw, 2.05rem);
    margin-bottom: 8px;
  }
  .vs-sub {
    color: var(--muted);
    font-size: 0.94rem;
    margin-bottom: 26px;
  }

  .download-form {
    gap: 0;
  }
  .download-form fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .vs-block {
    border-top: 1px solid var(--line);
    padding-top: 26px;
    margin: 0 0 26px;
    min-width: 0;
  }
  .vs-block:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .vs-block legend {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0;
    margin-bottom: 14px;
    font-size: 0.84rem;
    font-weight: 600;
  }
  .vs-block legend .req {
    color: var(--red);
  }
  .vs-step {
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    color: var(--red);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 2px 6px;
  }

  .build-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }
  .build-card {
    position: relative;
    display: block;
    cursor: pointer;
  }
  .build-card input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .build-card__body {
    position: relative;
    display: grid;
    gap: 5px;
    padding: 18px 18px 18px 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    height: 100%;
    overflow: hidden;
