---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { products } from "../data/products";
import { dealers } from "../data/dealers";

const title = "Contact Dicot | Dealers in Gujarat, Tamil Nadu & Mumbai";
const description =
  "Talk to Dicot about SCADA, IIoT or data-acquisition software. Ahmedabad office, +91 90166 83114, sales@dicot.tech. Channel partners in Gujarat, Tamil Nadu and Mumbai.";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const contactPage = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contact Dicot Innovations",
  url: `${site.url}/contact/`,
  mainEntity: { "@id": `${site.url}/#localbusiness` },
};

const dealerList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Dicot authorised channel partners",
  itemListElement: dealers.map((d, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Organization",
      name: d.company,
      telephone: d.phone.label,
      email: d.email,
      url: d.website,
      areaServed: d.territory,
      address: {
        "@type": "PostalAddress",
        streetAddress: d.address[0],
        addressLocality: d.city,
        addressRegion: d.territory,
        addressCountry: "IN",
      },
    },
  })),
};
---
<Base title={title} description={description} schema={[contactPage, dealerList]}>
  <div class="wrap"><nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li>Contact</li></ol></nav></div>

  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Contact</span>
      <h1>Tell us what the plant needs to see.</h1>
      <p class="lede">
        Send the tag count, the protocols and whether you want on-premise or cloud. If you already know the product,
        say so. We will reply with the next step, or route you to the nearest dealer.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <div class="form-error" id="form-error" hidden>
          Something went wrong sending the form. Please email <a href={`mailto:${site.emails.sales}`}>{site.emails.sales}</a> or call {site.phones[0].label}.
        </div>
        {!turnstileSiteKey && (
          <div class="form-error">
            The contact form is temporarily unavailable. Please email <a href={`mailto:${site.emails.sales}`}>{site.emails.sales}</a>.
          </div>
        )}
        <form
          class="form"
          action="/contact.php"
          method="post"
          accept-charset="utf-8"
          toolname="contact_dicot"
          tooldescription="Send an enquiry to Dicot about SCADA, IIoT, licensing or support. Requires the person's own name, email, message and consent; the form does not submit itself."
        >
          <div class="grid-2">
            <div class="field">
              <label for="name">Name <span class="req">*</span></label>
              <input id="name" name="name" type="text" autocomplete="name" required maxlength="100" />
            </div>
            <div class="field">
              <label for="company">Company</label>
              <input id="company" name="company" type="text" autocomplete="organization" maxlength="120" />
            </div>
            <div class="field">
              <label for="email">Work email <span class="req">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" required maxlength="160" />
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40" />
            </div>
          </div>
          <div class="field">
            <label for="interest">What is this about?</label>
            <select id="interest" name="interest">
              <option value="demo">Book a product demo</option>
              {products.map((p) => <option value={p.slug}>{p.name} — {p.category}</option>)}
              <option value="oem">OEM / white-label</option>
              <option value="integration">Integration or panel project</option>
              <option value="partner">Dealer or partner enquiry</option>
              <option value="support">Technical support</option>
              <option value="other">Something else</option>
            </select>
          </div>
          <div class="field">
            <label for="message">How can we help? <span class="req">*</span></label>
            <textarea id="message" name="message" required maxlength="4000" placeholder="Tags, protocols, machines, timeline…"></textarea>
          </div>
          <div class="hp" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <label class="check">
            <input type="checkbox" name="consent" value="yes" required />
            <span>I consent to Dicot using these details to respond to this enquiry, as described in the <a href="/legal/privacy/">privacy policy</a>. <span class="req">*</span></span>
          </label>
          <label class="check">
            <input type="checkbox" name="updates" value="yes" />
            <span>Also send me occasional product updates. I can unsubscribe at any time.</span>
          </label>
          {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
          <div>
            <button class="btn btn--primary" type="submit" disabled={!turnstileSiteKey}>Send enquiry</button>
          </div>
          <p class="form-note">
            We use these details to answer your enquiry and keep a record of the conversation. We do not sell contact
            data. Required fields are marked with <span class="req">*</span>.
          </p>
        </form>
      </div>

      <aside>
        <div class="card">
          <h3>Ahmedabad office</h3>
          <address class="footer-contact" style="font-style:normal;line-height:1.8">
            {site.address.full}<br />
            <a href={site.mapsUrl} rel="noopener">Open in Google Maps</a>
          </address>
          <h3 class="mt-3">Direct</h3>
          <p>
            <a href={`mailto:${site.emails.sales}`}>{site.emails.sales}</a><br />
            {site.phones.map((p) => (
              <><a href={`tel:${p.href}`}>{p.label}</a>{p.primary ? " (primary)" : " (office)"}<br /></>
            ))}
          </p>
          <h3 class="mt-3">Data and privacy</h3>
          <p><a href={`mailto:${site.emails.privacy}`}>{site.emails.privacy}</a></p>
          <h3 class="mt-3">Careers</h3>
          <p class="mb-0"><a href={`mailto:${site.emails.careers}`}>{site.emails.careers}</a></p>
        </div>
        <div class="card mt-2">
          <h3>Selling or integrating?</h3>
          <p>Dealers, integrators and OEMs can apply through the partner form. Tell us your territory and the industries you serve.</p>
          <a class="btn btn--ghost btn--small" href={site.partnerForm} rel="noopener">Partner application</a>
        </div>
        <div class="card mt-2">
          <h3>Existing customer?</h3>
          <p class="mb-0">For licence keys, renewals and support, include your product and licence ID so we can find the record faster.</p>
        </div>
      </aside>
    </div>
  </section>

  {turnstileSiteKey && <script async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>}

  <section class="section section--white" id="channel-partners">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Channel partners</span>
          <h2>Talk to a dealer near you.</h2>
        </div>
        <p>
          Authorised Dicot partners for Gujarat, Tamil Nadu and Mumbai. For any other region, write to
          <a href={`mailto:${site.emails.sales}`}>{site.emails.sales}</a> and we will route your enquiry.
        </p>
      </div>
      <div class="grid-3">
        {dealers.map((d) => (
          <article class="card dealer-card">
            <span class="mono muted">{d.territory}</span>
            <h3 class="mt-1">{d.company}</h3>
            <address>
              {d.address.map((line) => <>{line}<br /></>)}
            </address>
            <p class="dealer-card__contact">
              <a href={`tel:${d.phone.href}`}>{d.phone.label}</a><br />
              <a href={`mailto:${d.email}`}>{d.email}</a>
              {d.website && <><br /><a href={d.website} rel="noopener" target="_blank">Visit website ↗</a></>}
            </p>
          </article>
        ))}
      </div>
      <p class="form-note mt-3">
        Partner details are listed for enquiries about Dicot products. Dealer pricing and local taxes are handled by the
        partner in your territory.
      </p>
    </div>
  </section>
</Base>

<script>
  const params = new URLSearchParams(location.search);
  if (params.get("error") === "1") {
    document.getElementById("form-error")?.removeAttribute("hidden");
  }
  const interest = params.get("interest");
  const select = document.getElementById("interest") as HTMLSelectElement | null;
  if (interest && select && [...select.options].some((o) => o.value === interest)) {
    select.value = interest;
    document.getElementById("message")?.setAttribute("placeholder", "Tell us about the application, tag scope and timeline…");
  }
</script>
