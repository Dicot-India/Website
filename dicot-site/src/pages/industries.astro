---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import { industries } from "../data/content";
import { products } from "../data/products";

const title = "SCADA & IIoT by Industry | Dicot";
const description =
  "Dicot SCADA and IIoT software runs in pharma, textiles, food and beverage, machine tools, water treatment, foundry, ceramics, railway, HVAC, chemicals, oil and gas and packaging plants.";

const detail: Record<string, { text: string; points: string[]; product: string }> = {
  pharma: {
    text: "Regulated production needs more than a dashboard. Vision S records who changed what, when, and why, with audit trails and electronic signatures that hold up to an audit. Batch data is stored in PostgreSQL so quality teams can query it directly.",
    points: ["21 CFR-ready audit trails and e-signatures", "Batch recording with multiple simultaneous batches", "Reports with your formats and approval headers"],
    product: "vision-s",
  },
  textiles: {
    text: "Dyeing, spinning and processing lines fail quietly: a temperature drifts, a batch runs long, a shift loses the register. Vision C logs the process locally and Vision Web puts the line on a supervisor's phone.",
    points: ["Multi-port Modbus data collection", "Shift and batch reports", "Alarms by WhatsApp or SMS when a line drifts"],
    product: "vision-c",
  },
  "food-beverage": {
    text: "Temperature, pressure and time decide whether a batch is safe. Dicot software records the evidence continuously and turns it into a report that quality and customers can sign off.",
    points: ["Batch-wise logging and traceability", "Temperature and pressure alarms", "PDF reports with logo and batch header"],
    product: "vision-c",
  },
  "machine-tools": {
    text: "Machine builders should not become software companies. Vision C gives your machine a SCADA and data logger, and Vision Web gives your customer remote visibility — under your brand.",
    points: ["White-label OEM editions", "Licensing tied to machine warranty", "One-click cloud connection for your customer"],
    product: "vision-c",
  },
  "water-treatment": {
    text: "Water sites are remote, unmanned or both. Vision Web watches tank levels, flow, pH and conductivity, and escalates alarms to the people who can act.",
    points: ["Level, flow and quality trending", "SMS, WhatsApp and Telegram alarms", "Multi-site visibility from one login"],
    product: "vision-web",
  },
  foundry: {
    text: "Furnaces, moulding lines and cooling conveyors generate data in harsh conditions. Vision C runs on modest industrial PCs and keeps logging when the network does not.",
    points: ["Local history on the plant floor", "Furnace and cooling trend logs", "Shift comparison reports"],
    product: "vision-c",
  },
  ceramics: {
    text: "Kiln cycles are long and expensive to repeat. Dicot software records the full curve, compares batches and exports the evidence for customers and process teams.",
    points: ["Long-cycle trending and history", "Batch comparison", "Energy and temperature reporting"],
    product: "vision-s",
  },
  railway: {
    text: "Wayside and depot equipment is distributed across sites and often on poor networks. Vision C logs locally; Vision Web aggregates what matters centrally.",
    points: ["Distributed data collection", "Store-and-forward architecture", "Central alarms and reports"],
    product: "vision-web",
  },
  hvac: {
    text: "Comfort complaints and energy bills rarely arrive with the same owner. Vision Web tracks AHU temperatures, humidity and fan status, and alerts facilities before a space drifts.",
    points: ["AHU and room condition monitoring", "Humidity and temperature alarms", "Trends for energy reviews"],
    product: "vision-web",
  },
  chemical: {
    text: "Reactors, distillation columns and batch processes punish a missed setpoint. Dicot software logs temperature, pressure and pH continuously, alarms on deviation and keeps the batch record for audits and customers.",
    points: ["Reactor and batch trend logging", "Temperature, pressure and pH alarms", "Batch records with audit trail"],
    product: "vision-s",
  },
  "oil-gas": {
    text: "Wells, pipelines and compressor stations sit far from the control room. Vision C logs locally at the site and Vision Web brings flow, pressure and status back to one screen, with alarms when a line drifts.",
    points: ["Remote well and pipeline monitoring", "Store-and-forward on poor networks", "SMS and WhatsApp alarms"],
    product: "vision-web",
  },
  packaging: {
    text: "Every stop on a packing line costs output. Dicot software counts production, tracks speed and rejects, and shows where a shift lost time — without adding another historian.",
    points: ["Line speed and output counts", "Downtime and reject tracking", "Shift and production reports"],
    product: "vision-c",
  },
};

const bySlug = (slug: string) => products.find((p) => p.slug === slug)!;
---
<Base title={title} description={description}>
  <div class="wrap"><nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li>Industries</li></ol></nav></div>

  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Industries</span>
      <h1>Twelve industries. One data layer.</h1>
      <p class="lede">
        The equipment changes; the problem does not. Collect reliable data, keep it safe, show it to the right person
        and raise an alarm when it drifts. Here is how that looks in each industry we serve.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="logo-row" style="gap:10px">
        {industries.map((i) => (
          <a class="chip" href={`#${i.slug}`} style="text-decoration:none">{i.name}</a>
        ))}
      </div>
    </div>
  </section>

  {industries.map((ind, i) => {
    const d = detail[ind.slug];
    const p = bySlug(d.product);
    return (
      <section class:list={["section", i % 2 === 0 ? "" : "section--white"]} id={ind.slug}>
        <div class="wrap split">
          <div>
            <span class="eyebrow">Industry / {String(i + 1).padStart(2, "0")}</span>
            <h2>{ind.name}</h2>
            <p class="lede">{d.text}</p>
            <div class="btn-row">
              <a class="btn btn--dark btn--small" href={`/products/${p.slug}/`}>Built on {p.name}</a>
              <a class="btn btn--ghost btn--small" href="/contact/">Discuss your plant</a>
            </div>
          </div>
          <ul class="card" role="list">
            {d.points.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      </section>
    );
  })}

  <Cta title="Your industry not listed?" text="If it has machines, sensors and a person who needs to know when something drifts, it is probably a fit. Ask us." />
</Base>
